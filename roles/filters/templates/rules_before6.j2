*filter
-A ufw6-before-forward -i {{ bridge_name }} -m conntrack --ctstate NEW,ESTABLISHED,RELATED -j ACCEPT
-A ufw6-before-forward -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
-A ufw6-before-forward -i {{ ext_bridge_name }} -d 0::0d:10/::ffff:ffff -j ACCEPT
-A ufw6-before-forward -i {{ bridge_name }} -j ACCEPT
# play.googleapis.com
-A ufw6-before-forward -s 2001:4860:4802:32::0/60  -p tcp --sport 443 -j ACCEPT
# googleapis.com
-A ufw6-before-forward -s 2a00:1450:400f:800::0/60 -p tcp --sport 443 -j ACCEPT
-A ufw6-before-forward -s 2a00:1450:400f:800::0/60 -p udp --sport 443 -j ACCEPT
# www.google.com, for QUIC
-A ufw6-before-forward -s 2001:4860:4826:7700::0 -p udp --sport 443 -j ACCEPT
-A ufw6-before-forward -s 2001:4860:4827:7700::0 -p udp --sport 443 -j ACCEPT
-A ufw6-before-forward -s 2001:4860:4828:7700::0 -p udp --sport 443 -j ACCEPT
-A ufw6-before-forward -s 2001:4860:4828:7700::0 -p udp --sport 443 -j ACCEPT
-A ufw6-before-forward -s 2001:4860:482a:7700::0 -p udp --sport 443 -j ACCEPT
-A ufw6-before-forward -s 2001:4860:482b:7700::0 -p udp --sport 443 -j ACCEPT
-A ufw6-before-forward -s 2001:4860:482c:7700::0 -p udp --sport 443 -j ACCEPT
-A ufw6-before-forward -s 2001:4860:482d:7700::0 -p udp --sport 443 -j ACCEPT
#
-A ufw6-before-input -i {{ bridge_name }}  -d ff00::0/8 -j ACCEPT
COMMIT
#
*mangle
-I POSTROUTING -p tcp --tcp-flags SYN,RST SYN -o {{ external_if }} -j TCPMSS --clamp-mss-to-pmtu
{% if ext_bridge_name %}
-I POSTROUTING -p tcp --tcp-flags SYN,RST SYN -o {{ ext_bridge_name }} -j TCPMSS --clamp-mss-to-pmtu
{% endif %}
COMMIT
